<script>
  (function() {
    var outer = document.querySelector('.results-track-outer');
    var track = document.getElementById('resultsTrack');
    var prevBtn = document.getElementById('resultsPrev');
    var nextBtn = document.getElementById('resultsNext');
    var dotsEl = document.getElementById('resultsDots');
    var page = 0;
    var padLeft = parseFloat(getComputedStyle(outer).paddingLeft) || 0;
    function perView() { return window.innerWidth >= 768 ? 3 : 1; }
    function getCards() { return track.querySelectorAll('.result-card'); }
    function totalPages() { return Math.ceil(getCards().length / perView()); }
    function targetLeft(p) {
      var t = getCards()[p * perView()];
      return t ? (t.offsetLeft - outer.offsetLeft - padLeft) : 0;
    }
    function goTo(p, instant) {
      var n = totalPages();
      page = Math.max(0, Math.min(p, n - 1));
      outer.scrollTo({ left: targetLeft(page), behavior: instant ? 'auto' : 'smooth' });
      render();
    }
    function render() {
      var n = totalPages();
      prevBtn.disabled = page === 0;
      nextBtn.disabled = page === n - 1;
      dotsEl.innerHTML = '';
      for (var i = 0; i < n; i++) {
        var d = document.createElement('button');
        d.className = 'carousel-dot' + (i === page ? ' active' : '');
        d.setAttribute('aria-label', 'Page ' + (i + 1));
        (function(idx) { d.onclick = function() { goTo(idx); }; })(i);
        dotsEl.appendChild(d);
      }
    }
    prevBtn.onclick = function() { goTo(page - 1); };
    nextBtn.onclick = function() { goTo(page + 1); };

    // Keep dots/arrows in sync when swiping by hand
    var scrollT;
    outer.addEventListener('scroll', function() {
      clearTimeout(scrollT);
      scrollT = setTimeout(function() {
        var n = totalPages(), best = 0, bestD = Infinity;
        for (var i = 0; i < n; i++) {
          var d = Math.abs(outer.scrollLeft - targetLeft(i));
          if (d < bestD) { bestD = d; best = i; }
        }
        if (best !== page) { page = best; render(); }
      }, 90);
    }, { passive: true });

    // iOS Safari fires resize while you scroll (the URL bar collapsing).
    // Only reset the carousel when the width genuinely changes.
    var lastW = window.innerWidth;
    window.addEventListener('resize', function() {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      padLeft = parseFloat(getComputedStyle(outer).paddingLeft) || 0;
      goTo(0, true);
    });
    render();

    // Load + play only the clips on (or about to be on) screen.
    var videos = track.querySelectorAll('.result-media');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          var v = e.target;
          if (e.isIntersecting) {
            if (v.paused) { var p = v.play(); if (p && p.catch) p.catch(function(){}); }
          } else if (!v.paused) {
            v.pause();
          }
        });
      }, { root: outer, rootMargin: '0px 200px', threshold: 0.35 });
      videos.forEach(function(v) { io.observe(v); });
    } else {
      videos.forEach(function(v) { var p = v.play(); if (p && p.catch) p.catch(function(){}); });
    }
  })();
</script>
